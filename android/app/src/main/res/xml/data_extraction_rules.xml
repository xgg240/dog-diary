<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 数据提取规则
  禁止云端备份/设备迁移时导出用户数据
  （养狗日记有个人宠物健康数据，隐私敏感）
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
