// ============================================================
//  仪表盘顶卡: 选狗
// ============================================================


// ============================================================
//  AppBar 点标题 → 选狗菜单
// ============================================================
void _showPetPicker(BuildContext context, WidgetRef ref, List<Pet> pets, int? currentPetId) {
  showModalBottomSheet(
    context: context,
    showDragHandle: true,
    builder: (_) => SafeArea(
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          ListTile(
            leading: const Icon(Icons.list),
            title: const Text('📚 全部'),
            selected: currentPetId == null,
            onTap: () {
              ref.read(currentPetIdProvider.notifier).state = null;
              Navigator.pop(context);
            },
          ),
          const Divider(height: 1),
          for (final p in pets)
            ListTile(
              leading: const Text('🐕', style: TextStyle(fontSize: 22)),
              title: Text(p.name.isEmpty ? '未命名' : p.name),
              selected: currentPetId == p.id,
              onTap: () {
                ref.read(currentPetIdProvider.notifier).state = p.id;
                Navigator.pop(context);
              },
            ),
        ],
      ),
    ),
  );
}

